[Unit]
Description=Threads replies: Telegram bot for approving drafted replies
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=threads
Group=threads
WorkingDirectory=/home/threads/homuchen.com
Environment=PATH=/home/threads/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/home/threads/.config/threads-replies.env
ExecStart=/usr/bin/python3 /home/threads/homuchen.com/scripts/threads-replies/replies.py bot
Restart=always
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
